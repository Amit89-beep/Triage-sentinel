# Environment Configuration for Triage Sentinel

# LLM Providers (Optional for testing, MockLLMProvider is used by default in tests)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=

# Target Sandbox Microservice
TARGET_SANDBOX_URL=http://127.0.0.1:8000
CHAOS_MODE=normal

# Agent Guardrail Limits
MAX_STEPS=6
MAX_TOKENS=12000
MAX_WALL_SECONDS=30
